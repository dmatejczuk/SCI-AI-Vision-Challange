# No .env file is needed for the default http://localhost deployment.
# These settings apply only to docker-compose.network.yml.
# Replace this example with a hostname resolved by all clients (no scheme/path/port).
APP_HOST=vision.example.test
# internal: Caddy private CA; trust its root on every client.
# acme: public CA; requires your real domain, public DNS and reachable TCP 80/443.
APP_TLS_ISSUER=internal
